# LLM API Keys (for api-server.js chat proxy)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-...
GROK_API_KEY=...
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o

# Okta (sledai.oktapreview.com)
OKTA_API_TOKEN=your_okta_ssws_token
OKTA_ORG_URL=https://sledai.oktapreview.com
OKTA_API_DOMAIN=sledai.oktapreview.com

# App / Auth
# IMPORTANT: This machine is crowded. We deliberately chose 3200/3201
# because they were confirmed free at the time of setup.
# Change these if you ever get a conflict.
PORT=3200
API_PORT=3201
DEMO_AUTH_BYPASS=true
SESSION_SECRET=change-this-to-a-long-random-string-for-production

# When web and API are on different domains (like your ai-admin.* vs ai-admin-api.*)
# set this so the frontend knows where to call the API.
# Leave empty when using a reverse proxy (recommended).
VITE_API_BASE=https://ai-admin-api.skylarbarnes.com

# For session cookies when using separate subdomains over HTTPS
COOKIE_DOMAIN=.skylarbarnes.com
WEB_ORIGIN=https://ai-admin.skylarbarnes.com

# SAML 2.0 (IdP-initiated from Okta dashboard)
# Values below come from the Okta IDP metadata you provided.
SAML_ENTRY_POINT=https://sledai.oktapreview.com/app/sledai_superduperadmins_1/exkzd4x270Uxefp211d7/sso/saml
SAML_ISSUER=http://www.okta.com/exkzd4x270Uxefp211d7

# Paste the full certificate from Okta metadata here (can be single line or PEM)
SAML_

# SP (this application) configuration - MUST match what you configure in Okta
SAML_SP_ENTITY_ID=super-duper-admin-portal
SAML_SP_ACS_URL=http://YOUR-HOSTNAME:3201/api/saml/acs

# Where to send the user after successful SAML login
SAML_SUCCESS_REDIRECT=http://YOUR-HOSTNAME:3200/

# Optional: webhooks for destructive action approvals (legacy)
APPROVAL_WEBHOOK_URL=

# ===== HashiCorp Vault (optional — load Okta token from kv/Okta-Tenant) =====
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TOKEN=<client-token-with-read-on-kv>
# VAULT_KV_MOUNT=kv
# VAULT_KV_PATH=Okta-Tenant

# ===== Okta Access Requests — Governance API v2 (human-in-the-loop) =====
# request_access tool POSTs {OKTA_ORG_URL}/governance/api/v2/requests directly (no Workflows hop).
# Token needs scope okta.accessRequests.request.manage (ACCESS_REQUESTS_ADMIN role).
# OKTA_ACCESS_REQUESTS_TOKEN=<SSWS or OAuth token with access-requests manage scope>
# Map each canonical action.type to its OIG catalog entry id (cen…):
OKTA_ACCESS_REQUEST_CATALOG_ENTRIES={"suspend_user":"cen...","reset_user_mfa":"cen...","unsuspend_user":"cen..."}
# Who is requestedFor: "actor" (signed-in admin, default) or "target" (target.userId when present)
# OKTA_ACCESS_REQUEST_REQUESTED_FOR=actor
# Optional approval-sequence requester field ids (from Okta Access Requests console):
# OKTA_ACCESS_REQUEST_FIELD_JUSTIFICATION=<field-id>
# OKTA_ACCESS_REQUEST_FIELD_DESCRIPTION=<field-id>
# OKTA_ACCESS_REQUEST_FIELD_TARGET_USER=<field-id>
# OKTA_ACCESS_REQUEST_FIELD_CORRELATION_ID=<field-id>
# OKTA_ACCESS_REQUEST_EXTRA_FIELDS=[{"id":"...","type":"TEXT","value":"..."}]
# Legacy flo callback (optional — only if a Workflows flo still POSTs terminal status):
# FLO_CALLBACK_SECRET=
# v1 request types do not auto-run the Okta API op — portal executes after approval (default on):
# OKTA_EXECUTE_APPROVED_ACCESS_REQUESTS=true
# Runtime persistence (access-request cache + OIDC sessions) — default: ./.data
# SDAP_DATA_DIR=/var/lib/sdap

# ===== Agent token exchange (Cross App Access / ID-JAG) =====
OKTA_OIDC_CLIENT_ID=0oa<your-oidc-app-id>
AGENT_ID=<your-ud-agent-id>
OKTA_OIDC_REDIRECT_URI=https://<api-host>/api/oidc/callback
OIDC_SCOPES=openid profile email offline_access
AGENT_PRIVATE_KEY_PATH=./secrets/agent-private-key.json
AGENT_TOKEN_SCOPE=sdap.logs.read sdap.users.read sdap.users.manage sdap.act
RESOURCE_AS_ISSUER=https://<your-org>.oktapreview.com/oauth2/<custom-as-id>
